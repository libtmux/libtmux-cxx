@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The library starts threads for control-mode connections.
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/libtmuxTargets.cmake")

# `libtmux::testing` is defined only when the component is requested, so a
# program that does not ask cannot link a test archive by accident.
if("testing" IN_LIST libtmux_FIND_COMPONENTS)
  set(_libtmux_testing_targets
      "${CMAKE_CURRENT_LIST_DIR}/libtmuxTestingTargets.cmake")
  if(EXISTS "${_libtmux_testing_targets}")
    include("${_libtmux_testing_targets}")
    set(libtmux_testing_FOUND TRUE)
  else()
    # Set here rather than left to `check_required_components`, which sets the
    # flag without a message and reports only "set libtmux_FOUND to FALSE".
    set(libtmux_testing_FOUND FALSE)
    if("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows")
      set(_libtmux_testing_reason
          "the libtmux::testing component is POSIX-only and is unavailable in Windows packages")
    else()
      set(_libtmux_testing_reason
          "this libtmux was installed without its testing library, so the \"testing\" component is unavailable. Reconfigure and reinstall it with -DLIBTMUX_BUILD_TESTING_LIBRARY=ON.")
    endif()
    if(libtmux_FIND_REQUIRED_testing)
      set(libtmux_FOUND FALSE)
      set(libtmux_NOT_FOUND_MESSAGE "${_libtmux_testing_reason}")
      unset(_libtmux_testing_targets)
      unset(_libtmux_testing_reason)
      return()
    elseif(NOT libtmux_FIND_QUIETLY)
      message(WARNING "${_libtmux_testing_reason}")
    endif()
    unset(_libtmux_testing_reason)
  endif()
  unset(_libtmux_testing_targets)
endif()

check_required_components(libtmux)
