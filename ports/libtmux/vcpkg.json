{
  "name": "libtmux",
  "version-semver": "0.1.0-alpha.2",
  "port-version": 1,
  "maintainers": "Tony Narlock <tony@git-pull.com>",
  "description": [
    "A typed C++ interface to the tmux terminal multiplexer.",
    "Alpha prerelease: the API is not stable and may change without a deprecation period."
  ],
  "homepage": "https://github.com/libtmux/libtmux-cxx",
  "documentation": "https://github.com/libtmux/libtmux-cxx#readme",
  "license": "MIT",
  "supports": "!windows & !mingw",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "mcp": {
      "description": "Build libtmux-mcp-server, the MCP tool server over stdio",
      "dependencies": [
        "nlohmann-json"
      ]
    }
  }
}
