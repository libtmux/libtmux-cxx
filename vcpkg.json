{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "libtmux",
  "version-semver": "0.1.0-alpha.2",
  "description": "A typed C++ interface to the tmux terminal multiplexer.",
  "maintainers": [
    "Tony Narlock <tony@git-pull.com>"
  ],
  "homepage": "https://github.com/libtmux/libtmux-cxx",
  "license": "MIT",
  "dependencies": [],
  "features": {
    "tests": {
      "description": "Build the test suites",
      "dependencies": [
        {
          "name": "gtest",
          "platform": "!windows & !mingw"
        },
        {
          "name": "yaml-cpp",
          "platform": "!windows & !mingw"
        }
      ]
    },
    "mcp": {
      "description": "Build the MCP server (Windows exposes the psmux-safe subset)",
      "dependencies": [
        "nlohmann-json"
      ]
    }
  }
}
