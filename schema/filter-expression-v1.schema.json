{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libtmux.git-pull.com/schema/filter-expression-v1.schema.json",
  "title": "libtmux filter expression",
  "description": "A lowered filter expression as a flat sequence in prefix order. Groups, negations, and relations are bracketed by begin and end nodes so a reader never counts operands. Each node kind is a closed object: the fields it needs are required, the fields belonging to other kinds are not permitted, and the operator set is the one its kind actually uses. A schema that required only `kind` accepted `{\"kind\": \"string_test\"}`, which no reader can do anything with.",
  "type": "object",
  "required": [
    "version",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "description": "Schema version. A reader that does not recognise the value must refuse the document rather than guess."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "field_name": {
      "type": "string",
      "minLength": 1,
      "description": "tmux format name for a test, relation name for a relation."
    },
    "bracket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "end_group",
            "end_negation",
            "end_relation",
            "begin_negation"
          ]
        }
      }
    },
    "string_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "op",
        "operand"
      ],
      "properties": {
        "kind": {
          "const": "string_test"
        },
        "name": {
          "$ref": "#/$defs/field_name"
        },
        "op": {
          "enum": [
            "eq",
            "iexact",
            "contains",
            "startswith",
            "endswith"
          ],
          "description": "Exactly what StringOp lowers to. Ordering operators are absent because comparing tmux text by magnitude is a question this language does not ask, and inequality is absent because it is spelled with a negation."
        },
        "operand": {
          "type": "string",
          "description": "The value compared against, owned rather than referenced."
        }
      }
    },
    "bool_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "expected"
      ],
      "properties": {
        "kind": {
          "const": "bool_test"
        },
        "name": {
          "$ref": "#/$defs/field_name"
        },
        "expected": {
          "type": "boolean"
        }
      }
    },
    "number_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "op",
        "number"
      ],
      "properties": {
        "kind": {
          "const": "number_test"
        },
        "name": {
          "$ref": "#/$defs/field_name"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte"
          ]
        },
        "number": {
          "type": "integer",
          "description": "The value compared against, as a number rather than as its rendered text, so a compiler to tmux `-f` does not have to parse it back out."
        }
      }
    },
    "begin_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "conjunction"
      ],
      "properties": {
        "kind": {
          "const": "begin_group"
        },
        "conjunction": {
          "type": "boolean",
          "description": "True is and, false is or."
        }
      }
    },
    "begin_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "quantifier"
      ],
      "properties": {
        "kind": {
          "const": "begin_relation"
        },
        "name": {
          "$ref": "#/$defs/field_name"
        },
        "quantifier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "0 any_of, 1 all_of, 2 none_of, 3 is."
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/string_test"
        },
        {
          "$ref": "#/$defs/bool_test"
        },
        {
          "$ref": "#/$defs/number_test"
        },
        {
          "$ref": "#/$defs/begin_group"
        },
        {
          "$ref": "#/$defs/begin_relation"
        },
        {
          "$ref": "#/$defs/bracket"
        }
      ]
    }
  }
}
