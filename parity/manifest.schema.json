{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "libtmux C++ Python parity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "development",
    "mapping",
    "approvals",
    "evidence",
    "shards",
    "unresolved_conflicts",
    "bindings",
    "semantic_contract_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "release": {"$ref": "#/$defs/observation"},
    "development": {"$ref": "#/$defs/observation"},
    "mapping": {"$ref": "#/$defs/mapping"},
    "approvals": {"$ref": "approvals.schema.json"},
    "evidence": {"$ref": "evidence.schema.json"},
    "shards": {"$ref": "#/$defs/shards"},
    "unresolved_conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    },
    "bindings": {"$ref": "#/$defs/bindings"},
    "semantic_contract_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "safe_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "commit",
        "tree",
        "generator_version",
        "clean_policy",
        "clean"
      ],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/git_id"},
        "tree": {"$ref": "#/$defs/git_id"},
        "generator_version": {"type": "integer", "minimum": 1},
        "clean_policy": {"const": "recorded_inputs"},
        "clean": {"type": "boolean"}
      }
    },
    "input_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "inputs"],
      "properties": {
        "version": {"const": 1},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind"],
            "allOf": [
              {
                "if": {
                  "required": ["kind"],
                  "properties": {"kind": {"const": "toml_fields"}}
                },
                "then": {"required": ["fields"]},
                "else": {"not": {"required": ["fields"]}}
              }
            ],
            "properties": {
              "path": {"$ref": "#/$defs/safe_path"},
              "kind": {"enum": ["blob", "tree", "toml_fields"]},
              "fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "input_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "object_id"],
      "properties": {
        "path": {"$ref": "#/$defs/safe_path"},
        "kind": {"enum": ["blob", "tree", "toml_fields"]},
        "object_id": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40,64}|sha256:[0-9a-f]{64})$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "kind",
        "module",
        "qualname",
        "source_path",
        "signature",
        "value_shape",
        "decorators",
        "bases",
        "observable_protocols"
      ],
      "properties": {
        "entry_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "module": {"type": "string"},
        "qualname": {"type": "string", "minLength": 1},
        "source_path": {"$ref": "#/$defs/safe_path"},
        "signature": {"type": ["string", "null"]},
        "value_shape": true,
        "decorators": {"type": "array", "items": {"type": "string"}},
        "bases": {"type": "array", "items": {"type": "string"}},
        "observable_protocols": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "observation_id",
        "source",
        "input_manifest",
        "inputs",
        "entries"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "observation_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "input_manifest": {"$ref": "#/$defs/input_manifest"},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/input_object"}
        },
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/entry"}
        }
      }
    },
    "mapping_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "observed_in",
        "observation_hashes",
        "status",
        "cpp_symbol",
        "cpp_api_id",
        "cpp_alias_of",
        "compile_probe",
        "behavior_tests",
        "doc_id",
        "example_id",
        "error_behavior",
        "tmux_versions",
        "boundary_tests",
        "semantic_delta",
        "oracle_id",
        "approval_id",
        "reconciliation",
        "inapplicability_proof"
      ],
      "properties": {
        "entry_id": {"type": "string", "minLength": 1},
        "observed_in": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "observation_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/digest"}
        },
        "status": {"enum": ["pending", "implemented", "adapted", "excluded"]},
        "cpp_symbol": {"type": ["string", "null"]},
        "cpp_api_id": {"type": ["string", "null"]},
        "cpp_alias_of": {"type": ["string", "null"]},
        "compile_probe": {"type": ["string", "null"]},
        "behavior_tests": {"type": "array", "items": {"type": "string"}},
        "doc_id": {"type": ["string", "null"]},
        "example_id": {"type": ["string", "null"]},
        "error_behavior": {"type": ["string", "null"]},
        "tmux_versions": {"type": "array", "items": {"type": "string"}},
        "boundary_tests": {"type": "array", "items": {"type": "string"}},
        "semantic_delta": {"type": ["string", "null"]},
        "oracle_id": {"type": ["string", "null"]},
        "approval_id": {"type": ["string", "null"]},
        "reconciliation": {"type": ["object", "string", "null"]},
        "inapplicability_proof": {"type": ["string", "null"]}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "entries"],
      "properties": {
        "schema_version": {"const": 1},
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/mapping_entry"}
        }
      }
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "depends_on", "entry_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "entry_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "shards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "dependency_order", "shards"],
      "properties": {
        "schema_version": {"const": 1},
        "dependency_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "shards": {"type": "array", "items": {"$ref": "#/$defs/shard"}}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "fields", "observation_hashes"],
      "properties": {
        "entry_id": {"type": "string", "minLength": 1},
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["signature", "value_shape", "decorators", "bases"]}
        },
        "observation_hashes": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_sha256",
        "development_sha256",
        "mapping_sha256",
        "approvals_sha256",
        "evidence_sha256",
        "shards_sha256"
      ],
      "properties": {
        "release_sha256": {"$ref": "#/$defs/digest"},
        "development_sha256": {"$ref": "#/$defs/digest"},
        "mapping_sha256": {"$ref": "#/$defs/digest"},
        "approvals_sha256": {"$ref": "#/$defs/digest"},
        "evidence_sha256": {"$ref": "#/$defs/digest"},
        "shards_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
